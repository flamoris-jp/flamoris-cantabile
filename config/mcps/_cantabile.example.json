      "description": "Read the authoritative native project, revision and shared history.",
      "input_schema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "guard": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "runtimeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "documentToken": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "expectedRevision": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$",
                "maxLength": 19
              }
